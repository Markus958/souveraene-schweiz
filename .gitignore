# GitHub Pages veroeffentlicht den gesamten Checkout (deploy.yml, path: '.').
# Alles, was hier ausgeschlossen ist, wird nicht committet und gelangt damit
# auch nicht auf den Webserver.

# Interne Quelldaten und Zwischenstaende des Teilprojekts NGO.
# Nur NGO/README.md, NGO/build/ und NGO/doku/ werden versioniert.
NGO/daten/
NGO/ausgabe/

# Zusatzschutz: Datenlieferungen werden erfahrungsgemaess direkt nach NGO/
# kopiert statt nach NGO/lieferung/. Sie enthalten Klarnamen und duerfen nicht
# versehentlich committet werden.
# Ablauf: Lieferung nach NGO/lieferung/, dann
# python NGO/build/uebernimm_lieferung.py --uebernehmen
NGO/*.csv
NGO/*.json
NGO/*.xlsx
NGO/*.png
NGO/*.jpg
NGO/*.jpeg
NGO/data/
NGO/lieferung/
NGO/data_vorher/
ngo/data/
ngo/lieferung/
ngo/data_vorher/
ngo/daten/
ngo/ausgabe/

# Word-Arbeitsstaende (Schlussberichte, Lesefassungen) — nicht fuer die Website
*.docx

# Arbeitskopien von Office-Dateien und Windows-Ordnereinstellungen
~$*
desktop.ini

# Python
__pycache__/
*.pyc

# Nur fuer die Tests installiert (npm install --no-save jsdom), gehoert nicht ins Repo
node_modules/
