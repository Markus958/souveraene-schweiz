{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "organizations.csv row",
  "type": "object",
  "required": [
    "org_id",
    "name",
    "node_type",
    "category_id"
  ],
  "properties": {
    "org_id": {
      "type": "string",
      "pattern": "^NGO-[0-9]{4}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "node_type": {
      "const": "organisation"
    },
    "category_id": {
      "type": "string",
      "minLength": 1
    },
    "cluster_id": {
      "type": "string"
    },
    "parent_org_id": {
      "type": "string"
    }
  }
}