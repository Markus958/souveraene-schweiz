[Unit]
Description=Check every morning that the Newsmonitor daily run started

[Timer]
# Parallel-Abnahmephase: fünf Minuten nach GitHub. Nach Abschaltung des
# GitHub-Schedules kontrolliert auf 07:30:00 umstellen.
OnCalendar=*-*-* 07:35:00 Europe/Zurich
Persistent=true
AccuracySec=1min
Unit=newsmonitor-daily-trigger.service

[Install]
WantedBy=timers.target
