# Copy to /etc/newsmonitor/gmail-newsmonitor.env, replace values locally, then chmod 600.
GMAIL_CLIENT_SECRET_PATH=/var/lib/newsmonitor/gmail/client_secret.json
GMAIL_TOKEN_PATH=/var/lib/newsmonitor/gmail/token.json
GMAIL_STATE_PATH=/var/lib/newsmonitor/gmail/state.json
GMAIL_FEED_PATH=/var/lib/newsmonitor/gmail/feed.json
GMAIL_INITIAL_QUERY=newer_than:7d
GMAIL_FEED_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
